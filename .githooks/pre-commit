#!/usr/bin/env bash
# File generated by pre-commit: https://pre-commit.com
# ID: 138fd403232d2ddd5efb44317e38bf03
#
# Lives under version control (.githooks/) instead of .git/hooks/ so it's
# shared across clones — each clone needs to run
# `git config core.hooksPath .githooks` once (see CLAUDE.md). The
# PRE_COMMIT_HOME export below is the one manual addition on top of what
# `pre-commit install` generates: it keeps hook environments and
# pre-commit.log inside the repo (.cache/pre-commit/, gitignored) instead of
# ~/.cache/pre-commit. Regenerate with:
#   git config --unset-all core.hooksPath && pre-commit install && \
#   cp .git/hooks/pre-commit .githooks/pre-commit
# then re-add this block and `git config core.hooksPath .githooks`.

REPO_ROOT="$(git rev-parse --show-toplevel)"
export PRE_COMMIT_HOME="$REPO_ROOT/.cache/pre-commit"

# start templated
INSTALL_PYTHON=/opt/homebrew/opt/python@3.11/bin/python3.11
ARGS=(hook-impl --config=.pre-commit-config.yaml --hook-type=pre-commit)
# end templated

HERE="$(cd "$(dirname "$0")" && pwd)"
ARGS+=(--hook-dir "$HERE" -- "$@")

if [ -x "$INSTALL_PYTHON" ]; then
    exec "$INSTALL_PYTHON" -mpre_commit "${ARGS[@]}"
elif command -v pre-commit > /dev/null; then
    exec pre-commit "${ARGS[@]}"
else
    echo '`pre-commit` not found.  Did you forget to activate your virtualenv?' 1>&2
    exit 1
fi
